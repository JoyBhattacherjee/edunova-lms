# ---------- EduNova server configuration ----------
# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

PORT=5001

# Full PostgreSQL connection string:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local example:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/edunova

# Set to "true" for hosted databases that require SSL (Neon, Supabase, Render, Railway, Heroku...)
PG_SSL=false

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173
